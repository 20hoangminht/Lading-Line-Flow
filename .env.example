# Copy this file to .env and fill in the CHANGE-ME values.
# NEVER commit .env. It is in .gitignore for a reason.

DJANGO_SECRET_KEY=CHANGE-ME-to-any-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://flow:flow@db:5432/flow

# AWS Bedrock. For local development leave these blank and the app uses recorded fixtures
# instead of calling the model, which costs nothing.
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_ENABLED=false

# Usage meter. Blank locally — the meter writes to the database but sends nothing.
METER_ENDPOINT=
METER_SIGNING_KEY_ID=

# Confidence threshold below which a field goes to human review (0.0 to 1.0)
REVIEW_CONFIDENCE_THRESHOLD=0.85
